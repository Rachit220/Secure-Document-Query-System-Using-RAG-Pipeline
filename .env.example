# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Required: OpenAI API key for embeddings and LLM
OPENAI_API_KEY=sk_your_api_key_here

# LLM Model to use
LLM_MODEL=gpt-4o-mini

# Embedding model to use (text-embedding-3-small or text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
# Path to persist ChromaDB (can be local path or database connection string)
CHROMA_DB_PATH=./chroma_db

# ============================================================================
# TEXT PROCESSING CONFIGURATION
# ============================================================================
# Chunk size for text splitting (tokens)
CHUNK_SIZE=1000

# Overlap between chunks (tokens)
CHUNK_OVERLAP=100

# ============================================================================
# PII DETECTION CONFIGURATION
# ============================================================================
# Use Microsoft Presidio for PII detection (requires additional dependencies)
USE_PRESIDIO=true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# API Key for authentication - CHANGE THIS IN PRODUCTION
API_KEY=dev-key-change-in-production

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Host to bind to
HOST=0.0.0.0

# Port to listen on
PORT=8000

# Number of worker processes (1 for development, >1 for production)
WORKERS=1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================
# For PgVector (PostgreSQL with vector extension) instead of ChromaDB:
# DATABASE_URL=postgresql://user:password@localhost:5432/docquery_db
# VECTOR_DB_TYPE=pgvector

# For Pinecone (serverless vector DB):
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-west-2-aws
# VECTOR_DB_TYPE=pinecone
